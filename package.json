{
  "name": "smooth-slideshow",
  "version": "1.0.0",
  "description": "Modern 60fps Windows Desktop Image Slideshow App with Ken Burns Effect",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win portable",
    "perf:scan": "node tests/performance.js",
    "perf:render": "node tests/run-electron-smoke.js",
    "perf": "npm run perf:scan && npm run perf:render"
  },
  "keywords": [
    "slideshow",
    "electron",
    "kenburns",
    "windows",
    "desktop"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  }
}
